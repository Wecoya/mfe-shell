{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Per-service RED metrics, system resources, Kafka consumer, and Loki logs",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "RED Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "tooltip": { "mode": "single" } },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"$service\", namespace=\"$namespace\", cluster=\"$cluster\"}[2m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": { "tooltip": { "mode": "single" } },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"$service\", namespace=\"$namespace\", cluster=\"$cluster\", status=~\"5..\"}[2m])) / sum(rate(http_requests_total{service=\"$service\", namespace=\"$namespace\", cluster=\"$cluster\"}[2m]))",
          "legendFormat": "5xx error rate",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{service=\"$service\", namespace=\"$namespace\", cluster=\"$cluster\", status=~\"4..\"}[2m])) / sum(rate(http_requests_total{service=\"$service\", namespace=\"$namespace\", cluster=\"$cluster\"}[2m]))",
          "legendFormat": "4xx rate",
          "refId": "B"
        }
      ],
      "title": "Error Rate (4xx / 5xx)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service=\"$service\", namespace=\"$namespace\", cluster=\"$cluster\"}[2m])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"$service\", namespace=\"$namespace\", cluster=\"$cluster\"}[2m])) by (le))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service=\"$service\", namespace=\"$namespace\", cluster=\"$cluster\"}[2m])) by (le))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "title": "Latency (P50 / P95 / P99)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "System Resources",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", cluster=\"$cluster\", pod=~\"$service.*\"}[2m])) by (pod)",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "title": "CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"$namespace\", cluster=\"$cluster\", pod=~\"$service.*\", container!=\"\"}) by (pod)",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "title": "Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "targets": [
        {
          "expr": "count(kube_pod_info{namespace=\"$namespace\", cluster=\"$cluster\", pod=~\"$service.*\"})",
          "legendFormat": "pods",
          "refId": "A"
        }
      ],
      "title": "Pod Count",
      "type": "timeseries"
    },
    {
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Kafka (optional — shows No data if Kafka not used)",
      "type": "row",
      "panels": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
            "overrides": []
          },
          "gridPos": { "h": 6, "w": 8, "x": 0, "y": 15 },
          "id": 7,
          "targets": [
            {
              "expr": "sum(kafka_consumer_group_lag{namespace=\"$namespace\", cluster=\"$cluster\", consumergroup=~\"$service.*\"}) by (topic, partition)",
              "legendFormat": "{{ topic }}[{{ partition }}]",
              "refId": "A"
            }
          ],
          "title": "Kafka Consumer Lag",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "msgps", "color": { "mode": "palette-classic" } },
            "overrides": []
          },
          "gridPos": { "h": 6, "w": 8, "x": 8, "y": 15 },
          "id": 8,
          "targets": [
            {
              "expr": "sum(rate(kafka_producer_record_send_total{namespace=\"$namespace\", cluster=\"$cluster\", clientid=~\"$service.*\"}[2m]))",
              "legendFormat": "produced msg/s",
              "refId": "A"
            }
          ],
          "title": "Kafka Produced Messages/s",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "msgps", "color": { "mode": "palette-classic" } },
            "overrides": []
          },
          "gridPos": { "h": 6, "w": 8, "x": 16, "y": 15 },
          "id": 9,
          "targets": [
            {
              "expr": "sum(rate(kafka_consumer_records_consumed_total{namespace=\"$namespace\", cluster=\"$cluster\", clientid=~\"$service.*\"}[2m]))",
              "legendFormat": "consumed msg/s",
              "refId": "A"
            }
          ],
          "title": "Kafka Consumed Messages/s",
          "type": "timeseries"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 103,
      "title": "Logs",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${loki_datasource}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 },
      "id": 10,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "expr": "{namespace=\"$namespace\", app=\"$service\", cluster=\"$cluster\"} |= \"\" | json | level=~\"$log_level\"",
          "legendFormat": "",
          "refId": "A",
          "maxLines": 100
        }
      ],
      "title": "Service Logs (last 100 lines)",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 37,
  "tags": ["service", "monitoring", "per-service"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource",
        "label": "Prometheus"
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "loki_datasource",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource",
        "label": "Loki"
      },
      {
        "current": { "text": "psc-app-01", "value": "psc-app-01" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(up, cluster)",
        "hide": 0,
        "includeAll": false,
        "name": "cluster",
        "options": [],
        "query": "label_values(up, cluster)",
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "label": "Cluster"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(kube_namespace_labels{cluster=\"$cluster\"}, namespace)",
        "hide": 0,
        "includeAll": false,
        "name": "namespace",
        "options": [],
        "query": "label_values(kube_namespace_labels{cluster=\"$cluster\"}, namespace)",
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "label": "Namespace"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(up{namespace=\"$namespace\", cluster=\"$cluster\"}, job)",
        "hide": 0,
        "includeAll": false,
        "name": "service",
        "options": [],
        "query": "label_values(up{namespace=\"$namespace\", cluster=\"$cluster\"}, job)",
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "label": "Service"
      },
      {
        "current": { "text": "All", "value": "$__all" },
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "log_level",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "error", "value": "error" },
          { "selected": false, "text": "warn", "value": "warn" },
          { "selected": false, "text": "info", "value": "info" },
          { "selected": false, "text": "debug", "value": "debug" }
        ],
        "query": "error,warn,info,debug",
        "type": "custom",
        "label": "Log Level"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Service Overview — $service",
  "uid": null,
  "version": 1
}
